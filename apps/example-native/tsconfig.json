{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "types": ["jest"],
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "react-native-readium": ["../../packages/react-native-readium/src/index.tsx"],
      "react-native-readium-lcp": ["../../packages/react-native-readium-lcp/src/index.ts"]
    },
    "strict": true,
    "target": "esnext",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*", "**/node_modules", "**/Pods"]
}
