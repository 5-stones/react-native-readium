{
  "name": "react-native-readium-lcp",
  "version": "0.1.0",
  "description": "Readium LCP support for react-native-readium",
  "main": "lib/src/index",
  "types": "lib/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/gradle.properties",
    "ios",
    "nitrogen/generated",
    "nitro.json",
    "react-native-readium-lcp.podspec",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "prepare": "rimraf lib && tsc",
    "nitrogen": "nitrogen",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "readium",
    "lcp",
    "drm",
    "ebook"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/5-stones/react-native-readium",
    "directory": "packages/react-native-readium-lcp"
  },
  "author": "Jacob Spizziri <jspizziri@weare5stones.com> (https://github.com/jspizziri)",
  "license": "MIT",
  "bugs": {
    "url": "http://github.com/5-stones/react-native-readium/issues"
  },
  "homepage": "http://github.com/5-stones/react-native-readium/tree/main/packages/react-native-readium-lcp#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "jest": "^29.6.3",
    "nitrogen": "^0.35.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-readium": "workspace:*",
    "release-it": "^15.0.0",
    "rimraf": "^5.0.7",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": "*",
    "react-native-readium": ">=5.3.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release react-native-readium-lcp ${version}",
      "tagName": "react-native-readium-lcp@${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
