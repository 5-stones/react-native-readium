# Build settings for the example app. Copy this file to .env (gitignored) and fill in what you
# need; variables set in the shell override it. react-native-readium-lcp's readium_lcp_pods
# (ios/Podfile) and liblcp.gradle (android/app/build.gradle) read them.
#
# Linking EDRLab's liblcp (test or production) is optional. Its podspec URL and .aar come from
# EDRLab's integration instructions, which are private to their partners: put them in .env only,
# never in this file. Leave everything blank to build without liblcp: debug builds then use the
# basic-profile stand-in client (see README.md).

# iOS: URL of the R2LCPClient podspec. Rerun `pod install` after changing it.
READIUM_LCP_IOS_PODSPEC=

# Android: path to the liblcp .aar (absolute, or relative to this folder).
READIUM_LCP_ANDROID_AAR=
