{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for react-native-readium and react-native-readium-lcp",
  "scripts": {
    "api": "typedoc --options typedoc.readium.json && typedoc --options typedoc.lcp.json",
    "start": "yarn api && docusaurus start",
    "build": "yarn api && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear && rm -rf core/api lcp/api",
    "cut-version": "node scripts/cut-docs-version.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typedoc": "0.28.20",
    "typedoc-docusaurus-theme": "1.4.3",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "^5.8.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
