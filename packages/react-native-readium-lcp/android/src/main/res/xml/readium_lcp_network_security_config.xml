<?xml version="1.0" encoding="utf-8"?>
<!--
  Applied to the app by this package's manifest: an app has a single network security config.
  An app that declares its own must replace this one (tools:replace) and keep allowing cleartext.

  LCP needs cleartext traffic (see readium/kotlin-toolkit#211 and #241): EDRLab's certificate
  revocation list is served over HTTP (crl.edrlab.telesec.de), and so may be a provider's license
  and status servers. A network
  security config makes Android ignore android:usesCleartextTraffic, so it is allowed here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
