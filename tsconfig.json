{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "react-native-readium": ["./packages/react-native-readium/src/index"],
      "react-native-readium-lcp": ["./packages/react-native-readium-lcp/src/index"]
    },
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2017", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "skipLibCheck": true
  },
  "files": []
}
